<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Remove Windows AI bay Mekatik" Width="560" Height="680" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#0A0D17" Foreground="#E8ECF6"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="NeonBrush" Color="#3A63F5"/>
    <SolidColorBrush x:Key="Surface" Color="#111728"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#161E34"/>
    <SolidColorBrush x:Key="Line" Color="#232C45"/>
    <SolidColorBrush x:Key="Muted" Color="#8A94AD"/>
    <SolidColorBrush x:Key="Text" Color="#E8ECF6"/>

    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="RowDesc" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Baris opsi: seluruh baris adalah satu tombol toggle dengan saklar di kiri -->
    <Style x:Key="OptionRow" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="12,9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Track" Width="34" Height="18" CornerRadius="9" Background="#2A3350"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                  <Border x:Name="Thumb" Width="12" Height="12" CornerRadius="6" Background="#C9D1E6"
                          HorizontalAlignment="Left" Margin="3,0,0,0">
                    <Border.RenderTransform>
                      <TranslateTransform x:Name="ThumbMove" X="0"/>
                    </Border.RenderTransform>
                  </Border>
                </Border>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceHover}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#3A63F5"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource NeonBrush}"/>
                <Setter TargetName="Thumb" Property="Background" Value="White"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="#3A63F5"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ThumbMove" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ThumbMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tombol teks kecil (Pilih semua) -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#7F9BFF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="6,4"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tombol kontrol jendela -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="#9AA4BD"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1D2640"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tombol aksi bentuk pil -->
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Width" Value="128"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#3A63F5"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Scrollbar modern: tipis, tanpa panah, thumb membulat, biru saat disorot -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" Background="#2C3556" CornerRadius="4"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="Background" Value="#4468F0"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="T" Property="Background" Value="#6B8AFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Border Background="#0E1322" CornerRadius="5" Margin="1,0"/>
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" MinHeight="36" Margin="1"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Border Background="#0E1322" CornerRadius="5" Margin="0,1"/>
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}" MinWidth="36" Margin="1"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NeonProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="#1B2238" CornerRadius="4"/>
              <Border x:Name="PART_Track"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                      Background="{StaticResource NeonBrush}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: logo di tengah -->
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" ToolTip="Minimalkan">
          <Path Data="M0,0 L10,0" Stroke="#9AA4BD" StrokeThickness="1.2" Margin="0,8,0,0"/>
        </Button>
        <Button x:Name="BtnClose" Style="{StaticResource CaptionButton}" ToolTip="Tutup">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#9AA4BD" StrokeThickness="1.2"/>
        </Button>
      </StackPanel>
      <StackPanel Margin="24,28,24,6" HorizontalAlignment="Center">
        <Image x:Name="Logo" Width="340" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Bersihkan fitur AI dari Windows 11" Foreground="{StaticResource Muted}"
                   FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        <Rectangle Height="2" Width="120" RadiusX="1" RadiusY="1" Fill="{StaticResource NeonBrush}"
                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
      </StackPanel>
    </Grid>

    <!-- Daftar opsi -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="22,4,12,0" Padding="0,0,10,0">
      <StackPanel>
        <Grid Margin="2,4,0,8">
          <TextBlock Text="Hapus fitur AI" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
          <Button x:Name="BtnToggleAi" Style="{StaticResource LinkButton}" Content="Kosongkan"
                  HorizontalAlignment="Right"/>
        </Grid>
        <StackPanel x:Name="ListAi"/>

        <Grid Margin="2,10,0,8">
          <TextBlock Text="Aplikasi klasik" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
          <Button x:Name="BtnToggleClassic" Style="{StaticResource LinkButton}" Content="Pilih semua"
                  HorizontalAlignment="Right"/>
        </Grid>
        <StackPanel x:Name="ListClassic"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Mode -->
    <Grid Grid.Row="2" Margin="22,8,22,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ToggleButton x:Name="TglRevert" Grid.Column="0" Style="{StaticResource OptionRow}" Margin="0">
        <StackPanel>
          <TextBlock Text="Mode Revert" Style="{StaticResource RowTitle}"/>
          <TextBlock Text="Kembalikan fitur AI yang dipilih seperti semula." Style="{StaticResource RowDesc}"/>
        </StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="TglBackup" Grid.Column="2" Style="{StaticResource OptionRow}" Margin="0">
        <StackPanel>
          <TextBlock Text="Mode Backup" Style="{StaticResource RowTitle}"/>
          <TextBlock Text="Simpan cadangan untuk Revert dan buat titik pemulihan dulu." Style="{StaticResource RowDesc}"/>
        </StackPanel>
      </ToggleButton>
    </Grid>

    <!-- Tombol aksi di tengah -->
    <StackPanel Grid.Row="3" Margin="0,12,0,8" HorizontalAlignment="Center">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="BtnCancel" Content="Batal" Style="{StaticResource PillButton}" Margin="0,0,14,0"/>
        <Button x:Name="BtnApply" Content="Terapkan" Style="{StaticResource PillButton}"
                Background="{StaticResource NeonBrush}" BorderThickness="0"/>
      </StackPanel>
      <TextBlock Text="© 2026 Mekatik" Foreground="#5B6683" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>

    <!-- Lapisan proses -->
    <Grid x:Name="Overlay" Grid.RowSpan="4" Background="#F2080B14" Visibility="Collapsed">
      <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Surface}"
              BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="26">
        <StackPanel>
          <TextBlock x:Name="OverlayTitle" Text="Sedang diproses" FontSize="18" FontWeight="Bold"/>
          <TextBlock x:Name="OverlayStep" Text="Menyiapkan..." Foreground="{StaticResource Muted}" Margin="0,6,0,14"
                     TextWrapping="Wrap"/>
          <ProgressBar x:Name="Progress" Style="{StaticResource NeonProgress}" Minimum="0" Maximum="100" Value="0"/>
          <TextBox x:Name="LogBox" Height="120" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   Background="#0A0E1B" Foreground="#9FB3D9" BorderBrush="{StaticResource Line}"
                   FontFamily="Consolas" FontSize="11.5" Padding="8"/>
          <StackPanel x:Name="DonePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0"
                      Visibility="Collapsed">
            <Button x:Name="BtnLater" Content="Nanti saja" Style="{StaticResource PillButton}" Margin="0,0,12,0"
                    BorderBrush="#3A63F5"/>
            <Button x:Name="BtnRestart" Content="Mulai ulang" Style="{StaticResource PillButton}"
                    Background="{StaticResource NeonBrush}" BorderThickness="0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
